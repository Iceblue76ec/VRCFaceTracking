<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:s="using:VRCFaceTracking.Strings"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:model="clr-namespace:VRCFaceTracking;assembly=VRCFaceTracking.Core"
    x:DataType="vm:MainViewModel"
    x:Class="VRCFaceTracking.Views.MainPage">

    <ScrollViewer>
        <StackPanel Margin="0,10,0,20" Spacing="12">
            <Border
                IsVisible="{Binding NoModulesInstalled, Mode=OneWay}"
                CornerRadius="6"
                BorderThickness="1"
                Padding="20,15">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFC107" Opacity="0.6" />
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#FFC107" Opacity="0.08" />
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ui:SymbolIcon Symbol="Alert" FontSize="20" VerticalAlignment="Center" Foreground="#FFC107" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static s:Resources.no_modules_installed_warning_Title}" />
                        <TextBlock FontSize="12" Opacity="0.7"
                                   Text="{x:Static s:Resources.no_modules_installed_warning_Description}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.6" Text="{x:Static s:Resources.Main_Modules_Header}" />

            <ItemsControl ItemsSource="{Binding LibManager.LoadedModulesMetadata}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:ModuleMetadataInternal">
                        <Border CornerRadius="6" BorderThickness="1" Margin="0,0,0,4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid Margin="16,14" ColumnDefinitions="Auto,*,Auto">

                                <ItemsControl Grid.Column="0" Margin="0,0,12,0"
                                              ItemsSource="{Binding StaticImages}"
                                              IsVisible="{Binding StaticImages, Converter={StaticResource HasModuleImagesConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Image Source="{Binding Converter={StaticResource StreamToBitmapConverter}}"
                                                       Height="72"
                                                       Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay, Converter={StaticResource PlaceholderTextConverter}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Static s:Resources.EyeTrackingActive_Text}" FontSize="12" Opacity="0.7"
                                                   IsVisible="{Binding UsingEye, Mode=OneWay}" />
                                        <TextBlock Text="{x:Static s:Resources.FaceTrackingActive_Text}" FontSize="12" Opacity="0.7"
                                                   IsVisible="{Binding UsingExpression, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding Active, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.6"
                       Text="{x:Static s:Resources.Main_Status_Header}" Margin="0,8,0,0" />
            <Border CornerRadius="6" BorderThickness="1" Padding="20,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto,2*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Width="96" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="4">
                        <ui:SymbolIcon Symbol="Camera" FontSize="22" HorizontalAlignment="Center"
                                       ToolTip.Tip="{x:Static s:Resources.Main_TrackingModule_Tooltip}" />
                        <TextBlock FontWeight="SemiBold" FontSize="12"
                                   Text="{x:Static s:Resources.Main_TrackingModule_Label}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Opacity="0.65"
                            Background="#808080" />

                    <StackPanel Grid.Column="2" Width="140" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="4">
                        <ui:FontIcon Glyph="&#xEC05;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                     FontSize="22" HorizontalAlignment="Center"
                                     ToolTip.Tip="{x:Static s:Resources.Main_Relay_Tooltip}" />
                        <TextBlock FontWeight="SemiBold" FontSize="12" Text="VRCFaceTracking"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="3" CornerRadius="4" Padding="10,7"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto"
                              ColumnSpacing="6" RowSpacing="6" VerticalAlignment="Center">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="←" FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11"
                                       Text="{x:Static s:Resources.Main_Receive_Label}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{x:Static s:Resources.Main_Receive_Tooltip}" />
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="127.0.0.1" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OscTarget.EffectiveInPort, Mode=OneWay, StringFormat=':{0}'}"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static s:Resources.Main_Receive_Disconnected}" FontSize="11"
                                           VerticalAlignment="Center" Opacity="0.6"
                                           IsVisible="{Binding !OscTarget.IsReceiving}" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="3" FontSize="11"
                                       Text="{Binding MessagesInPerSec, Mode=OneWay, StringFormat='{}{0}/s'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="→" FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11"
                                       Text="{x:Static s:Resources.Main_Send_Label}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding OscTarget.DestinationAddress, Mode=OneWay}">
                                <TextBlock Text="{Binding OscTarget.DestinationAddress, Mode=OneWay}"
                                           FontSize="11" VerticalAlignment="Center" MaxWidth="95"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OscTarget.OutPort, Mode=OneWay, StringFormat=':{0}'}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="3" FontSize="11"
                                       Text="{Binding MessagesOutPerSec, Mode=OneWay, StringFormat='{}{0}/s'}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4" Width="70" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="4">
                        <ui:SymbolIcon Symbol="Contact" FontSize="22" HorizontalAlignment="Center"
                                       ToolTip.Tip="{x:Static s:Resources.Main_VRChat_Tooltip}" />
                        <TextBlock FontWeight="SemiBold" FontSize="12" Text="VRChat"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="6" BorderThickness="1" Padding="16,14" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Contact" FontSize="24" VerticalAlignment="Center" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding ParameterOutputService.AvatarInfo.Name, Mode=OneWay, Converter={StaticResource PlaceholderTextConverter}}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding ParameterOutputService.AvatarInfo.Id, Mode=OneWay, Converter={StaticResource PlaceholderTextConverter}}" />
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ParameterOutputService.AvatarInfo.Id, Mode=OneWay, Converter={StaticResource IsLocalTestAvatarConverter}}">
                                <Ellipse Width="8" Height="8" Fill="Red" VerticalAlignment="Center" />
                                <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                           Text="{x:Static s:Resources.LocalTestAvatar_Text}"
                                           ToolTip.Tip="{x:Static s:Resources.LocalTestAvatarTooltip_Content}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <TextBlock FontSize="12" Text="{Binding ParameterOutputService.AvatarParameters.Count, Mode=OneWay}" />
                            <TextBlock FontSize="12" Opacity="0.6" Text="{x:Static s:Resources.Parameters_Text}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"
                                    IsVisible="{Binding ParameterOutputService.AvatarParameters, Mode=OneWay, Converter={StaticResource HasLegacyParametersConverter}}">
                            <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Text="{Binding ParameterOutputService.AvatarParameters, Mode=OneWay, Converter={StaticResource LegacyParameterCountConverter}}" />
                            <TextBlock FontSize="12" Opacity="0.6" Text="{x:Static s:Resources.LegacyParameters_Text}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
