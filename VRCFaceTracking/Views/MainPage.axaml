<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:s="using:VRCFaceTracking.Strings"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:model="clr-namespace:VRCFaceTracking;assembly=VRCFaceTracking.Core"
    x:DataType="vm:MainViewModel"
    x:Class="VRCFaceTracking.Views.MainPage">

    <UserControl.Styles>
        <Style Selector="Border.home-module-card"><Setter Property="MinHeight" Value="104" /></Style>
        <Style Selector=":is(UserControl).spacious Border.home-module-card"><Setter Property="MinHeight" Value="180" /></Style>
        <Style Selector="Image.home-module-image"><Setter Property="Height" Value="72" /></Style>
        <Style Selector=":is(UserControl).spacious Image.home-module-image"><Setter Property="Height" Value="140" /></Style>
        <Style Selector="TextBlock.home-module-name"><Setter Property="FontSize" Value="16" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-module-name"><Setter Property="FontSize" Value="27" /></Style>
        <Style Selector="TextBlock.home-module-detail"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-module-detail"><Setter Property="FontSize" Value="15" /></Style>
        <Style Selector="TextBlock.home-section-header"><Setter Property="FontSize" Value="13" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-section-header"><Setter Property="FontSize" Value="17" /></Style>
        <Style Selector="TextBlock.home-node-label"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-node-label"><Setter Property="FontSize" Value="15" /></Style>
        <Style Selector="TextBlock.home-endpoint"><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-endpoint"><Setter Property="FontSize" Value="14" /></Style>
        <Style Selector="TextBlock.home-flow-arrow"><Setter Property="FontSize" Value="15" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-flow-arrow"><Setter Property="FontSize" Value="18" /></Style>
        <Style Selector="Border.home-status-card"><Setter Property="MinHeight" Value="94" /></Style>
        <Style Selector=":is(UserControl).spacious Border.home-status-card"><Setter Property="MinHeight" Value="125" /></Style>
        <Style Selector="Border.home-avatar-card"><Setter Property="MinHeight" Value="80" /></Style>
        <Style Selector=":is(UserControl).spacious Border.home-avatar-card"><Setter Property="MinHeight" Value="125" /></Style>
        <Style Selector="TextBlock.home-avatar-name"><Setter Property="FontSize" Value="14" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-avatar-name"><Setter Property="FontSize" Value="20" /></Style>
        <Style Selector="TextBlock.home-avatar-detail"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector=":is(UserControl).spacious TextBlock.home-avatar-detail"><Setter Property="FontSize" Value="14" /></Style>
        <Style Selector="ToggleButton.home-tracking-button">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector=":is(UserControl).spacious ToggleButton.home-tracking-button">
            <Setter Property="MinWidth" Value="210" />
            <Setter Property="Height" Value="76" />
        </Style>
        <Style Selector="ToggleButton.home-tracking-button:checked">
            <Setter Property="Background" Value="#0067B9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0067B9" />
        </Style>
        <Style Selector="ToggleButton.home-tracking-button:checked:pointerover">
            <Setter Property="Background" Value="#005A9E" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="0,10,0,20" Spacing="12">
            <Border
                IsVisible="{Binding NoModulesInstalled, Mode=OneWay}"
                CornerRadius="6"
                BorderThickness="1"
                Padding="20,15">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFC107" Opacity="0.6" />
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#FFC107" Opacity="0.08" />
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ui:SymbolIcon Symbol="Alert" FontSize="20" VerticalAlignment="Center" Foreground="#FFC107" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static s:Resources.no_modules_installed_warning_Title}" />
                        <TextBlock FontSize="12" Opacity="0.7"
                                   Text="{x:Static s:Resources.no_modules_installed_warning_Description}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="home-section-header" FontWeight="SemiBold" Opacity="0.6" Text="{x:Static s:Resources.Main_Modules_Header}" />

            <ItemsControl ItemsSource="{Binding LibManager.LoadedModulesMetadata}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:ModuleMetadataInternal">
                        <Border Classes="home-module-card" CornerRadius="6" BorderThickness="1" Margin="0,0,0,4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid Margin="16,14" ColumnDefinitions="Auto,*,Auto">

                                <ItemsControl Grid.Column="0" Margin="0,0,12,0"
                                              ItemsSource="{Binding StaticImages}"
                                              IsVisible="{Binding StaticImages, Converter={StaticResource HasModuleImagesConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Image Classes="home-module-image" Source="{Binding Converter={StaticResource StreamToBitmapConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="home-module-name" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay, Converter={StaticResource PlaceholderTextConverter}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding Active}">
                                        <TextBlock Classes="home-module-detail" Text="{x:Static s:Resources.EyeTrackingActive_Text}" Opacity="0.7"
                                                   IsVisible="{Binding UsingEye, Mode=OneWay}" />
                                        <TextBlock Classes="home-module-detail" Text="{x:Static s:Resources.FaceTrackingActive_Text}" Opacity="0.7"
                                                   IsVisible="{Binding UsingExpression, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !Active}">
                                        <TextBlock Classes="home-module-detail" Text="{x:Static s:Resources.EyeTrackingInactive_Text}" Opacity="0.7"
                                                   IsVisible="{Binding UsingEye, Mode=OneWay}" />
                                        <TextBlock Classes="home-module-detail" Text="{x:Static s:Resources.FaceTrackingInactive_Text}" Opacity="0.7"
                                                   IsVisible="{Binding UsingExpression, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <ToggleButton
                                    Classes="home-tracking-button"
                                    Grid.Column="2"
                                    IsChecked="{Binding Active, Mode=TwoWay}"
                                    IsVisible="{Binding !IsPlaceholder}"
                                    ToolTip.Tip="{x:Static s:Resources.ToggleTracking_Content}"
                                    VerticalAlignment="Center" Margin="20,0,12,0">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static s:Resources.ToggleTracking_Content}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{x:Static s:MainPageStrings.TrackingOn}" FontSize="12" IsVisible="{Binding Active}" />
                                        <TextBlock Text="{x:Static s:MainPageStrings.TrackingPaused}" FontSize="12" IsVisible="{Binding !Active}" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="home-section-header" FontWeight="SemiBold" Opacity="0.6"
                       Text="{x:Static s:Resources.Main_Status_Header}" Margin="0,8,0,0" />
            <Border Classes="home-status-card" CornerRadius="6" BorderThickness="1" Padding="20,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto,2*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Width="96" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="4">
                        <ui:SymbolIcon Symbol="Camera" FontSize="22" HorizontalAlignment="Center"
                                       ToolTip.Tip="{x:Static s:Resources.Main_TrackingModule_Tooltip}" />
                        <TextBlock Classes="home-node-label" FontWeight="SemiBold"
                                   Text="{x:Static s:Resources.Main_TrackingModule_Label}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Opacity="0.65"
                            Background="#808080" />

                    <StackPanel Grid.Column="2" Width="140" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="4">
                        <ui:FontIcon Glyph="&#xEC05;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                     FontSize="22" HorizontalAlignment="Center"
                                     ToolTip.Tip="{x:Static s:Resources.Main_Relay_Tooltip}" />
                        <TextBlock Classes="home-node-label" FontWeight="SemiBold" Text="VRCFaceTracking"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="3" CornerRadius="4" Padding="10,7"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto"
                              ColumnSpacing="6" RowSpacing="6" VerticalAlignment="Center">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="home-flow-arrow" Text="←"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="home-endpoint"
                                       Text="{x:Static s:Resources.Main_Receive_Label}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{x:Static s:Resources.Main_Receive_Tooltip}" />
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="home-endpoint" Text="127.0.0.1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OscTarget.EffectiveInPort, Mode=OneWay, StringFormat=':{0}'}"
                                           Classes="home-endpoint" VerticalAlignment="Center" />
                                <TextBlock Classes="home-endpoint" Text="{x:Static s:Resources.Main_Receive_Disconnected}"
                                           VerticalAlignment="Center" Opacity="0.6" Margin="6,0,0,0"
                                           IsVisible="{Binding !OscTarget.IsReceiving}" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="3" Classes="home-endpoint"
                                       Text="{Binding MessagesInPerSec, Mode=OneWay, StringFormat='{}{0}/s'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="home-flow-arrow" Text="→"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="home-endpoint"
                                       Text="{x:Static s:Resources.Main_Send_Label}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding OscTarget.DestinationAddress, Mode=OneWay}">
                                <TextBlock Text="{Binding OscTarget.DestinationAddress, Mode=OneWay}"
                                           Classes="home-endpoint" VerticalAlignment="Center" MaxWidth="95"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OscTarget.OutPort, Mode=OneWay, StringFormat=':{0}'}"
                                           Classes="home-endpoint" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="3" Classes="home-endpoint"
                                       Text="{Binding MessagesOutPerSec, Mode=OneWay, StringFormat='{}{0}/s'}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4" Width="70" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="4">
                        <ui:SymbolIcon Symbol="Contact" FontSize="22" HorizontalAlignment="Center"
                                       ToolTip.Tip="{x:Static s:Resources.Main_VRChat_Tooltip}" />
                        <TextBlock Classes="home-node-label" FontWeight="SemiBold" Text="VRChat"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Classes="home-section-header" FontWeight="SemiBold" Opacity="0.6"
                       Text="{x:Static s:Resources.AvatarStatus_Text}" Margin="0,8,0,0" />
            <Border Classes="home-avatar-card" CornerRadius="6" BorderThickness="1" Padding="16,14" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Contact" FontSize="24" VerticalAlignment="Center" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="home-avatar-name" FontWeight="SemiBold" Text="{Binding ParameterOutputService.DisplayAvatarInfo.Name, Mode=OneWay, Converter={StaticResource PlaceholderTextConverter}}" />
                            <TextBlock Classes="home-avatar-detail" Opacity="0.7" Text="{Binding ParameterOutputService.DisplayAvatarInfo.Id, Mode=OneWay}" />
                            <TextBlock Classes="home-avatar-detail" Opacity="0.7" IsVisible="{Binding ParameterOutputService.IsAvatarPreview}"
                                       Text="{x:Static s:MainPageStrings.AvatarPreview}" TextWrapping="Wrap" MaxWidth="420" />
                            <TextBlock Classes="home-avatar-detail" Foreground="#D99032" IsVisible="{Binding ParameterOutputService.ShowFaceTrackingHint}"
                                       Text="{x:Static s:MainPageStrings.AvatarFaceTrackingHint}" TextWrapping="Wrap" MaxWidth="420" />
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ParameterOutputService.DisplayAvatarInfo.Id, Mode=OneWay, Converter={StaticResource IsLocalTestAvatarConverter}}">
                                <Ellipse Width="8" Height="8" Fill="Red" VerticalAlignment="Center" />
                                <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                           Text="{x:Static s:Resources.LocalTestAvatar_Text}"
                                           ToolTip.Tip="{x:Static s:Resources.LocalTestAvatarTooltip_Content}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <TextBlock FontSize="12" Text="{Binding ParameterOutputService.DisplayParameterCount, Mode=OneWay}" />
                            <TextBlock FontSize="12" Opacity="0.6" Text="{x:Static s:Resources.Parameters_Text}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"
                                    IsVisible="{Binding ParameterOutputService.DisplayLegacyCount, Mode=OneWay, Converter={StaticResource PositiveNumberConverter}}">
                            <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Text="{Binding ParameterOutputService.DisplayLegacyCount, Mode=OneWay}" />
                            <TextBlock FontSize="12" Opacity="0.6" Text="{x:Static s:Resources.LegacyParameters_Text}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
