<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:svc="using:VRCFaceTracking.Services"
    xmlns:models="clr-namespace:VRCFaceTracking.Models"
    xmlns:s="using:VRCFaceTracking.Strings"
    x:DataType="vm:OutputViewModel"
    x:Class="VRCFaceTracking.Views.OutputPage">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FFF7F8FA" />
                    <SolidColorBrush x:Key="LogWarningBrush" Color="#805000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FF202124" />
                    <SolidColorBrush x:Key="LogWarningBrush" Color="#FFD66B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="SelectableTextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource LogWarningBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" CornerRadius="6" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button ToolTip.Tip="{x:Static s:Resources.Output_CopyAll_Tooltip}" Click="CopyToClipboard_Click" Padding="8">
                    <ui:SymbolIcon Symbol="Copy" FontSize="16" />
                </Button>
                <Button ToolTip.Tip="{x:Static s:Resources.Output_SaveToFile_Tooltip}" Click="SaveToFile_Click" Padding="8">
                    <ui:SymbolIcon Symbol="Save" FontSize="16" />
                </Button>
                <Separator />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.6" FontSize="12" Margin="8,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" Padding="4"
                Background="{DynamicResource LogBackgroundBrush}">
            <ListBox x:Name="LogItems"
                     ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.AllowAutoHide="False">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                    <Style Selector="ListBox /template/ ScrollViewer">
                        <Setter Property="Padding" Value="0,0,0,16" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:LogLine">
                        <SelectableTextBlock
                            x:Name="LogText"
                            Text="{Binding Message}"
                            FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                            FontSize="12"
                            Padding="6,1"
                            TextWrapping="NoWrap"
                            Classes.warning="{Binding Level, Converter={StaticResource LogLevelMatchConverter}, ConverterParameter=Warning}"
                            Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
